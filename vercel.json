{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npx next build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
