# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Cron job authentication (required — all cron routes validate this)
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me

# Optional ingest protection token (recommended in production)
# INGEST_API_TOKEN=change-me

# Optional smoke target override
# ADEVAR_BASE_URL=https://www.adevar.ai

# Telegram channel bot (optional — sync works without it)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHANNEL_ID=@adevar_ai
