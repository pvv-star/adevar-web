# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Cron job authentication (required — all cron routes validate this)
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me

# Upstash Redis for rate limiting (recommended in production, falls back to in-memory)
# UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN

# Optional ingest protection token (recommended in production)
# INGEST_API_TOKEN=change-me

# Optional smoke target override
# ADEVAR_BASE_URL=https://www.adevar.ai

# AI Chat — free tier fallback chain: Gemini → Groq → Cloudflare
# At least one must be configured for chat to work
# GEMINI_API_KEY=your_gemini_api_key
# GROQ_API_KEY=your_groq_api_key
# CF_AI_TOKEN=your_cloudflare_ai_token
# CF_ACCOUNT_ID=your_cloudflare_account_id

# AI Chat — premium tier (Claude Haiku)
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Stripe subscriptions (50 lei/month premium plan)
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PRICE_ID=price_...
# NEXT_PUBLIC_SITE_URL=https://www.adevar.ai

# Voice features — premium only
# OPENAI_API_KEY=sk_... (Whisper STT, ~$0.006/min)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key
# ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# Telegram channel bot (optional — sync works without it)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHANNEL_ID=@adevar_ai
