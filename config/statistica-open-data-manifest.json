  "ingestionPhases": {
    "P1": [
      "energy",
      "economy",
      "demography",
      "infrastructure-investments"
    ],
    "P2": [
      "industry",
      "agriculture",
      "external-trade"
    ],
    "P3": [
      "transport-tourism",
      "social",
      "justice-finance"
    ]
  },
  "ingestionRules": {
    "global": {
      "timezone": "Europe/Chisinau",
      "fallbackOnFailure": "keep_last_good_value",
      "maxAllowedConsecutiveFailures": 3
    },
    "byPhase": {
      "P1": {
        "requiredOwner": true,
        "requiredFreshnessSlaHours": true,
        "freshnessSlaHoursDefault": 48,
        "qualityGate": "strict"
      },
      "P2": {
        "requiredOwner": true,
        "requiredFreshnessSlaHours": false,
        "qualityGate": "standard"
      },
      "P3": {
        "requiredOwner": false,
        "requiredFreshnessSlaHours": false,
        "qualityGate": "best_effort"
      }
    }
  },
  "executionPlan": {
    "phase": "P1",
    "objective": "Ingest core public indicators into Supabase with strict freshness and ownership",
    "steps": [
      "Create Supabase tables + upsert keys for P1 datasets",
      "Implement source adapters for StatBank/communiques/calendar",
      "Schedule ingestion jobs (hourly/daily by dataset frequency)",
      "Enable freshness monitors + delay alerts",
      "Expose read APIs from curated Supabase tables only"
    ]
  }
}
